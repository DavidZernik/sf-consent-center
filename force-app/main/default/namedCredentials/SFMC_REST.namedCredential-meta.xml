<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SFMC REST</label>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <!-- Registered so the REST host is an allowed endpoint. The Authorization header is set
         explicitly by SfmcClient because the tenant returns its own rest_instance_url. -->
    <endpoint>https://tenant.rest.marketingcloudapis.com</endpoint>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <externalCredential>SFMC</externalCredential>
</NamedCredential>
