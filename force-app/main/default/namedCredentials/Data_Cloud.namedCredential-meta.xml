<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Data Cloud</label>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <!-- Points at the org's own My Domain: the CDP grant exchanges a core token for a
         Data Cloud token, so the first hop is back to Salesforce itself. -->
    <endpoint>https://myorg.my.salesforce.com</endpoint>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <externalCredential>Data_Cloud_JWT</externalCredential>
</NamedCredential>
